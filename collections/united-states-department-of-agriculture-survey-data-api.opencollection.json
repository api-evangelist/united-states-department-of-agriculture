{
  "opencollection": "1.0.0",
  "info": {
    "name": "USDA ERS ARMS Data Survey Data API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Survey Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get ARMS Survey Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ers.usda.gov/data/arms/surveydata",
            "params": [
              {
                "name": "api_key",
                "value": "DEMO_KEY",
                "type": "query",
                "description": "API key from api.data.gov"
              },
              {
                "name": "year",
                "value": "2022",
                "type": "query",
                "description": "Survey year (required)"
              },
              {
                "name": "report",
                "value": "farm_income",
                "type": "query",
                "description": "Report name to retrieve data for"
              },
              {
                "name": "variable",
                "value": "",
                "type": "query",
                "description": "Specific variable code(s) to retrieve"
              },
              {
                "name": "state",
                "value": "IA",
                "type": "query",
                "description": "Two-letter state abbreviation or NATIONAL"
              }
            ]
          },
          "docs": "Retrieve ARMS farm survey data by year, state, report, and variable. Year is required; at least one of report or variable is also required. Supports GET and POST methods."
        }
      ]
    }
  ],
  "bundled": true
}
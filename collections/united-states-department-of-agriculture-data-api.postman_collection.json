                  "description": "(Required) Comma-separated station IDs"
                },
                {
                  "disabled": false,
                  "key": "elementCds",
                  "value": "<string>",
                  "description": "(Required) Element codes to retrieve (WTEQ=Snow Water Equivalent, PREC=Precipitation, TOBS=Air Temperature Observed, SMS=Soil Moisture)"

{
  "opencollection": "1.0.0",
  "info": {
    "name": "USDA ERS ARMS Data Forecasts API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Forecasts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Water Supply Forecasts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ers.usda.gov/data/arms/forecasts",
            "params": [
              {
                "name": "stationIds",
                "value": "",
                "type": "query",
                "description": "Forecast point station IDs"
              },
              {
                "name": "stateCds",
                "value": "ID",
                "type": "query",
                "description": "State codes to filter forecasts"
              },
              {
                "name": "forecastPeriodCds",
                "value": "",
                "type": "query",
                "description": "Forecast period codes (e.g. JAN-SEP)"
              }
            ]
          },
          "docs": "Retrieve water supply forecasts for forecast points, including streamflow volume forecasts by probability exceedance levels."
        }
      ]
    }
  ],
  "bundled": true
}